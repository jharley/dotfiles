[
  {
    "label": "Go: test current package",
    "command": "go",
    "args": ["test", "-v", "$ZED_DIRNAME"],
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/bash",
        "args": ["--login"]
      }
    },
    "use_new_terminal": false
  },
  {
    "label": "Go: toggle test file",
    "command": "/Users/jason.harley/bin/zed-toggle-test",
    "args": ["$ZED_FILE"],
    "reveal": "never",
    "hide": "always",
    "use_new_terminal": false
  },
  {
    "label": "Rust: cargo run",
    "command": "cargo",
    "args": ["run"],
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/bash",
        "args": ["--login"]
      }
    },
    "use_new_terminal": false
  }
]
