{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(gcloud * list *)",
      "Bash(gcloud * describe *)",
      "Bash(gcloud * get-iam-policy *)",
      "Bash(gcloud config list *)",
      "Bash(gcloud config get *)",
      "Bash(gcloud projects list *)",
      "Bash(gcloud projects describe *)",
      "Bash(gcloud auth list *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git branch)",
      "Bash(git remote *)",
      "Bash(git remote)",
      "Bash(git tag *)",
      "Bash(git tag)",
      "Bash(git stash list *)",
      "Bash(git stash list)",
      "Bash(git config --get *)",
      "Bash(git config --list *)",
      "Bash(git config --list)",
      "Bash(git ls-files *)",
      "Bash(git ls-files)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git rev-parse *)",
      "Bash(git describe *)",
      "Bash(git cat-file *)",
      "Bash(git ls-tree *)",
      "Bash(git for-each-ref *)",
      "Bash(gsutil ls *)",
      "Bash(gsutil cat *)",
      "Bash(gsutil stat *)",
      "Bash(bq ls *)",
      "Bash(bq show *)",
      "Bash(bq query --dry_run *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh repo list *)",
      "Bash(gh repo view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh workflow list *)",
      "Bash(gh workflow view *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh auth status *)",
      "Bash(gh search *)",
      "Bash(terraform init *)",
      "Bash(terraform init)",
      "Bash(terraform validate *)",
      "Bash(terraform validate)",
      "Bash(terraform plan *)",
      "Bash(terraform plan)",
      "Bash(terraform fmt *)",
      "Bash(terraform fmt)",
      "Bash(terraform show *)",
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go mod *)",
      "mcp__go-linear__go-linear_issue_get"
    ],
    "deny": [
      "Read(./.env)"
    ],
    "ask": [
      "Bash(git stash:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin +*:*)",
      "Bash(git push upstream +*:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout -- .:*)",
      "Bash(git restore .:*)",
      "Bash(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(terraform apply)",
      "Bash(terraform apply *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "skipAutoPermissionPrompt": true,
  "timeFormat": "24-hour"
}
